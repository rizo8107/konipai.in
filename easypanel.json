{
  "name": "konipai",
  "type": "web",
  "image": "ghcr.io/konipai/konipai:latest",
  "domains": [
    "konipai.in",
    "www.konipai.in"
  ],
  "ports": [
    {
      "external": 80,
      "internal": 80,
      "protocol": "http"
    }
  ],
  "env": [
    {
      "name": "NODE_ENV",
      "value": "production"
    },
    {
      "name": "EASYPANEL_BUILD",
      "value": "true"
    },
    {
      "name": "SKIP_IMAGE_OPTIMIZATION",
      "value": "true"
    },
    {
      "name": "VITE_POCKETBASE_URL",
      "value": "https://backend-pocketbase.7za6uc.easypanel.host/"
    },
    {
      "name": "VITE_RAZORPAY_KEY_ID",
      "value": "rzp_live_3rZx2njbNwMEE1"
    },
    {
      "name": "VITE_RAZORPAY_PROXY_URL",
      "value": "https://konipai-server.7za6uc.easypanel.host"
    },
    {
      "name": "VITE_RAZORPAY_PROXY_KEY", 
      "value": "5cfd34e6-ef3b-4121-bfce-945d96a178d9"
    },
    {
      "name": "VITE_SITE_TITLE",
      "value": "Konipai"
    },
    {
      "name": "VITE_SITE_LOGO",
      "value": "https://konipai.in/assets/logo.png"
    }
  ],
  "resources": {
    "cpu": "500m",
    "memory": "512Mi"
  },
  "build": {
    "type": "dockerfile",
    "dockerfile": "Dockerfile",
    "buildOptions": {
      "memory": 2048,
      "memswap": 4096,
      "cpuShares": 4,
      "buildkit": true,
      "platform": "linux/amd64",
      "noCache": false
    }
  },
  "healthcheck": {
    "path": "/",
    "port": 80,
    "initialDelaySeconds": 30,
    "periodSeconds": 10
  },
  "restartPolicy": "always",
  "networks": ["default"]
} 