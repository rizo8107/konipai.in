{
  "name": "konipai-frontend",
  "description": "Konipai Frontend Application",
  "image": "ghcr.io/rizo8107/konipai.in:latest",
  "imagePullPolicy": "Always",
  "imagePullSecrets": [
    {
      "name": "ghcr-secret",
      "username": "rizo8107",
      "password": "${GITHUB_PAT}"
    }
  ],
  "ports": [
    {
      "port": 80,
      "targetPort": 80,
      "protocol": "http"
    }
  ],
  "env": [
    {
      "name": "VITE_POCKETBASE_URL",
      "value": "https://backend-pocketbase.7za6uc.easypanel.host"
    },
    {
      "name": "VITE_RAZORPAY_KEY_ID",
      "value": "rzp_live_3rZx2njbNwMEE1"
    }
  ],
  "resources": {
    "cpu": "100m",
    "memory": "256Mi"
  },
  "healthcheck": {
    "path": "/",
    "port": 80,
    "interval": "30s",
    "timeout": "10s",
    "retries": 3
  },
  "restartPolicy": "always",
  "networks": ["default"]
} 